# Server-only secrets. Never prefix these with NEXT_PUBLIC_ and never put them in frontend/.env.

FOOTBALL_DATA_API_KEY=your_api_key_from_football_data_org_here
OPENWEATHER_API_KEY=your_api_key_from_openweather_here
GEMINI_API_KEY=

# Next.js server rewrite target. The browser calls same-origin /api only.
API_INTERNAL_URL=http://127.0.0.1:8000

# FastAPI allowlists (comma-separated). On Railway, set CORS_ORIGINS to the public frontend URL.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUSTED_HOSTS=localhost,127.0.0.1

# Set to 1 only if you need /docs on the API process
PREMIERIQ_DEBUG=
